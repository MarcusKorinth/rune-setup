# Ignore everything by default, then allow only repository-owned paths.
*

# Repository configuration
!/.gitignore
!/.gitattributes
!/.editorconfig
!/.nvmrc
!/.npmrc
!/package.json
!/package-lock.json
!/tsconfig.json
!/tsconfig.*.json
!/eslint.config.js
!/.prettierignore
!/vitest.config.ts
!/.dependency-cruiser.cjs
!/.github/
!/.github/**

# Root documentation and project metadata
!/CHANGELOG.md
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/LICENSE
!/README.md

# Source packages, tests, and docs
!/docs/
!/docs/**
!/examples/
!/examples/**
!/scripts/
!/scripts/**
!/packages/
!/packages/**
!/tests/
!/tests/**

# Generated Node/TypeScript/Electron build artifacts inside allowed directories
**/node_modules/
**/dist/
**/build/
**/out/
**/output/
**/coverage/
**/*.tsbuildinfo
.eslintcache

# Never commit local environment files, logs, packed tarballs, OS cruft, or tool outputs
# inside the allowed subtrees
**/.env
**/.env.*
!**/.env.example
**/*.log
**/*.tgz
**/.DS_Store
**/Thumbs.db
**/.vite/
**/test-results/
**/playwright-report/
**/release/
