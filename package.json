{
  "name": "rune-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "RUNE — Runtime for User Guided and Non Interactive Execution (workspace root)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:shell": "npm run build && node scripts/build-shell.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "depcruise": "depcruise packages tests --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:packages": "node scripts/verify-packages.mjs",
    "test:shell:package": "node scripts/verify-shell.mjs",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.10.0",
    "prettier": "^3.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "~4.1.11"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "trailingComma": "all",
    "semi": true
  }
}
